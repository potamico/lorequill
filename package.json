{
  "name": "lorequill-workspace",
  "version": "0.3.0",
  "private": true,
  "description": "Monorepo root for Lorequill - Structured Knowledge Documentation for Visual Studio Code",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:integration:headless": "xvfb-run -a npm run test:integration",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:unit",
    "postinstall": "patch-package --error-on-fail",
    "test:e2e:github": "vitest run --config vitest.e2e.config.mts",
    "test:webview": "playwright test",
    "package": "npm run package -w vscode-lorequill"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vscode-languageclient": {
      "minimatch": "11.0.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
